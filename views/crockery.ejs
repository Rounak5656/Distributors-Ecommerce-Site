    <meta property="og:title" content="Kailash Electronics - Wholesale Crockery">
    <meta property="og:description" content="Wholesale crockery: dinner sets, mugs, plates, bowls. Request quotes and bulk orders.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/crockery.css">
    <script src="/javascripts/theme.js"></script>
</head>
<body class="themeable-page">
    <header class="header">
        <div class="header-left">
            <h1 class="brand-name">Kailash Electronics</h1>
            <p>Wholesale Crockery Distribution</p>
        </div>
        <div class="header-actions">
            <button class="icon-btn" id="wishlistBadge" aria-label="Wishlist">
                <i class="fas fa-heart"></i>
                <span id="wishlistCount">0</span>
            </button>
            <button class="icon-btn" id="cartBadge" aria-label="Cart">
                <i class="fas fa-shopping-cart"></i>
                <span id="cartCount">0</span>
            </button>
        </div>
    </header>

    <div class="search-bar">
        <input type="search" id="productSearch" placeholder="Search products..." aria-label="Search products">
    </div>

    <nav class="categories">
        <button class="category-btn" data-category="all">All Items</button>
        <button class="category-btn" data-category="dinner-sets">Dinner Sets</button>
        <button class="category-btn" data-category="cups-mugs">Cups & Mugs</button>
        <button class="category-btn" data-category="plates">Plates</button>
        <button class="category-btn" data-category="bowls">Bowls</button>
        <button class="category-btn" data-category="special">Special Offers</button>
