    <div class="products-grid" id="productsGrid">
        <div class="product-card" data-category="dinner-sets" data-title="Glass Juice Cup with Lid and Straw">
            <div class="product-image">
                <img src="/images/deli glassware.png" alt="Premium Dinner Set" loading="lazy" decoding="async" width="600" height="600">
                <img src="/images/deli glassware2.png" alt="Premium Dinner Set" loading="lazy" decoding="async" width="600" height="600">
                <img src="/images/deli glswr3.png" alt="Premium Dinner Set" loading="lazy" decoding="async" width="600" height="600">
                <button class="wishlist-btn" onclick="toggleWishlist(this)">
                    <i class="far fa-heart"></i>
                </button>
            </div>
            <div class="product-info">
                <h3 class="product-title">Glass Juice Cup with Lid and Straw</h3>
                <p class="product-description">Elegant 24-piece dinner set with modern design</p>
                <p class="min-order"><i class="fas fa-box"></i> Minimum Order: 10 sets</p>
                <button class="add-to-cart" onclick="addToCart(this)">
                    <i class="fas fa-shopping-cart"></i> Add to Cart
                </button>
                <button class="whatsapp-cta" data-phone="+917400944474">
                    <i class="fab fa-whatsapp"></i> Get Quote on WhatsApp
                </button>
            </div>
        </div>

        <div class="product-card" data-category="cups-mugs" data-title="Ceramic Coffee Mugs">
            <div class="product-image">
                <img src="/images/deli glassware2.png" alt="Premium Dinner Set" loading="lazy" decoding="async" width="600" height="600">
                <button class="wishlist-btn" onclick="toggleWishlist(this)">
                    <i class="far fa-heart"></i>
                </button>
            </div>
            <div class="product-info">
                <h3 class="product-title">Ceramic Coffee Mugs</h3>
                <p class="product-description">Set of 4 ceramic mugs with handle</p>
                <p class="min-order"><i class="fas fa-box"></i> Minimum Order: 25 sets</p>
                <button class="add-to-cart" onclick="addToCart(this)">
                    <i class="fas fa-shopping-cart"></i> Add to Cart
                </button>
                <button class="whatsapp-cta" data-phone="+917400944474">
                    <i class="fab fa-whatsapp"></i> Get Quote on WhatsApp
                </button>
            </div>
        </div>

        <div class="product-card" data-category="plates" data-title="Melamine Plates">
