            width="600" 
            height="450" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Kailash Electronics Location Map">
        </iframe>
    </div>

    <!-- Zebronics Category -->
    <section class="category-section">
        <h2 class="category-title">Zebronics</h2>
        <nav class="products">
            <div class="product-card">
                <a href="zebronics/it.ejs">
                    <span>IT PRODUCTS</span>
                </a>
            </div>
            <div class="product-card">
                <a href="zebronics/tv.ejs">
                    <span>TELEVISION</span>
                </a>
            </div>
            <div class="product-card">
                <a href="zebronics/speakers.ejs">
                    <span>SPEAKERS</span>
                </a>
            </div>
            <div class="product-card">
                <a href="zebronics/ac.ejs">
                    <span>A.C</span>
                </a>
            </div>
        </nav>
    </section>

    <!-- GEM Category -->
    <section class="category-section">
        <h2 class="category-title">Gem</h2>
        <nav class="products">
            <div class="product-card">
                <a href="GEM/fridge.ejs">
                    <span>FRIDGE</span>
                </a>
            </div>
            <div class="product-card">
                <a href="GEM/tv.ejs">
                    <span>TELEVISION</span>
                </a>
            </div>
            <div class="product-card">
                <a href="GEM/wm.ejs">
                    <span>WASHING MACHINE</span>
                </a>
            </div>
            <div class="product-card">
                <a href="GEM/ac.ejs">
                    <span>A.C</span>
                </a>
            </div>
        </nav>
    </section>

    <!-- Intex Category -->
    <section class="category-section">
        <h2 class="category-title">Intex</h2>
        <nav class="products">
            <div class="product-card">
                <a href="/INTEX/fridge">
                    <span>FRIDGE</span>
                </a>
            </div>
            <div class="product-card">
                <a href="/INTEX/tv">
                    <span>TELEVISION</span>
                </a>
            </div>
            <div class="product-card">
                <a href="/INTEX/wm">
                    <span>WASHING MACHINE</span>
                </a>
            </div>
            <div class="product-card">
                <a href="/INTEX/ac">
                    <span>A.C</span>
                </a>
            </div>
        </nav>
    </section>

    <!-- Takara Category -->
    <section class="category-section">
        <h2 class="category-title">Takara</h2>
        <nav class="products">
            <div class="product-card">
                <a href="TAKARA/fridge.ejs">
                    <span>FRIDGE</span>
                </a>
            </div>
            <div class="product-card">
                <a href="TAKARA/tv.ejs">
                    <span>TELEVISION</span>
                </a>
            </div>
            <div class="product-card">
                <a href="TAKARA/wm.ejs">
                    <span>WASHING MACHINE</span>
                </a>
            </div>
            <div class="product-card">
                <a href="TAKARA/ac.ejs">
                    <span>A.C</span>
                </a>
            </div>
        </nav>
    </section>

    <meta name="description" content="Kailash Electronics invitation card and product showcase">
    <meta name="keywords" content="Kailash Electronics, invitation, fridge, TV, washing machine, AC, crockery">

    <footer class="footer">
        <p>These are the companies we deal with:</p>
        <p style="margin-top: 10px; font-size: 0.9em; color: var(--text-secondary);">
            © 2024 Kailash Electronics - Electronics & Appliances Distributor. All rights reserved.
        </p>
    </footer>
    <div class="navigation-arrows">
        <a href="/crockery.ejs" class="nav-arrow">→</a>
    </div>

    <script>
        // Smooth scrolling for better UX
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add loading animation for product cards
        window.addEventListener('load', () => {
            const productCards = document.querySelectorAll('.product-card');
            productCards.forEach((card, index) => {
                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
</body>
</html>