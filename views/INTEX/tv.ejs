    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        nav { background: rgba(26, 26, 26, 0.95); padding: 1em 2em; display: flex; justify-content: flex-end; align-items: center; box-shadow: 0 2px 8px rgba(0,0,0,0.3); position: sticky; top: 0; z-index: 100; }
        nav a { background: #4ecdc4; color: #1a1a1a; padding: 0.6em 1.4em; border-radius: 20px; text-decoration: none; font-weight: 600; transition: background 0.3s; display: flex; align-items: center; gap: 0.5em; }
        nav a:hover { background: #38b2ac; }
        body {
            margin: 0 auto;
            max-width: 1200px;
            width: 95%;
            background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
            color: #fff;
            font-family: 'Poppins', sans-serif;
            line-height: 1.6;
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .header { text-align: center; margin: 2em 0; animation: fadeIn 1s ease-in; flex: 0 0 auto; position: relative; }
        .header h1 { font-size: 2.2em; margin-bottom: 0.2em; color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .header p { color: #b2f7ef; font-size: 0.95em; }
        .breadcrumbs { text-align: center; margin-top: .5em; color: #9adbd7; font-size: .85em; }

        .section-title { margin: 1.2em 0 .3em; padding-left: .4em; border-left: 4px solid #4ecdc4; color: #4ecdc4; font-size: 1.2em; letter-spacing: .5px; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.4em; padding: 1.4em; max-width: 1200px; margin: 0 auto; }
        .product-card { background: linear-gradient(145deg, #2a2a2a, #1a1a1a); border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.2); transition: transform 0.3s ease, box-shadow 0.3s; position: relative; color: #fff; display: flex; flex-direction: column; align-items: stretch; }
        .product-card:hover { transform: translateY(-8px); box-shadow: 0 16px 32px rgba(78,205,196,0.15); }
        .badge { position: absolute; top: 12px; left: 12px; background: #4ecdc4; color: #1a1a1a; font-weight: 700; padding: .25em .6em; border-radius: 6px; font-size: .75em; z-index: 10; }
        
        .product-image { 
            width: 100%; 
            aspect-ratio: 16 / 9;
            background: rgba(255,255,255,0.05); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            position: relative; 
            overflow: hidden;
        }
        .image-slider { width: 100%; height: 100%; position: relative; display: flex; align-items: center; justify-content: center; }
        .slider-image { position: absolute; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.5s ease; }
        .slider-image.active { opacity: 1; }
        .slider-image img { max-width: 100%; max-height: 100%; object-fit: contain; }
        .slider-image img.image-error { display: none; }
        .slider-image.image-missing::before { 
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3em;
            color: #4ecdc4;
            opacity: 0.7;
        }
        .slider-image.image-missing::after {
            content: '⚠';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 3em;
            color: #4ecdc4;
            opacity: 0.9;
            z-index: 1;
        }
        .no-image-text {
            position: absolute;
            bottom: 15%;
            left: 50%;
            transform: translateX(-50%);
            color: #bcefee;
            font-size: 0.85em;
            text-align: center;
            z-index: 2;
            width: 90%;
        }
        
        .slider-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.6); color: #4ecdc4; border: none; width: 30px; height: 30px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; z-index: 5; opacity: 0; }
        .product-image:hover .slider-nav { opacity: 1; }
        .slider-nav:hover { background: #4ecdc4; color: #1a1a1a; }
        .slider-nav.prev { left: 8px; }
        .slider-nav.next { right: 8px; }
        
        .slider-dots { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; z-index: 5; opacity: 0; transition: opacity 0.3s ease; }
        .product-image:hover .slider-dots { opacity: 1; }
        .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(78,205,196,0.5); cursor: pointer; transition: all 0.3s ease; }
        .dot.active { background: #4ecdc4; transform: scale(1.2); }
        
