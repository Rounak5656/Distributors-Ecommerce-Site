    <script>
        // Handle missing images
        document.querySelectorAll('.slider-image img').forEach(img => {
            img.addEventListener('error', function() {
                this.classList.add('image-error');
                const sliderImage = this.closest('.slider-image');
                sliderImage.classList.add('image-missing');
                
                // Add no image text if not already present
                if (!sliderImage.querySelector('.no-image-text')) {
                    const textDiv = document.createElement('div');
                    textDiv.className = 'no-image-text';
                    textDiv.textContent = 'Image Not Available';
                    sliderImage.appendChild(textDiv);
                }
            });
        });

        // Image Slider Functions
        function changeSlide(button, direction) {
            const sliderContainer = button.closest('.product-image');
            const slider = sliderContainer.querySelector('.image-slider');
            const images = slider.querySelectorAll('.slider-image');
            const dots = sliderContainer.querySelectorAll('.dot');
            
            let currentIndex = Array.from(images).findIndex(img => img.classList.contains('active'));
            let newIndex = (currentIndex + direction + images.length) % images.length;
            
            updateSlider(images, dots, newIndex);
        }
        
        function goToSlide(event, dotsContainer) {
            if (event.target.classList.contains('dot')) {
                const index = parseInt(event.target.getAttribute('data-index'));
                const sliderContainer = dotsContainer.parentElement;
                const slider = sliderContainer.querySelector('.image-slider');
                const images = slider.querySelectorAll('.slider-image');
                const dots = sliderContainer.querySelectorAll('.dot');
                
                updateSlider(images, dots, index);
            }
        }
        
        function updateSlider(images, dots, newIndex) {
            images.forEach(img => img.classList.remove('active'));
            dots.forEach(dot => dot.classList.remove('active'));
            
            images[newIndex].classList.add('active');
            dots[newIndex].classList.add('active');
        }

        // Wishlist Feature (shared localStorage)
        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            const card = btn.closest('.product-card');
            const id = card.getAttribute('data-id');
            if(JSON.parse(localStorage.getItem('wishlist')||'[]').includes(id)) {
                btn.classList.add('active');
            }
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                let wishlist = JSON.parse(localStorage.getItem('wishlist')||'[]');
                if(wishlist.includes(id)) {
                    wishlist = wishlist.filter(x=>x!==id);
                    btn.classList.remove('active');
                } else {
                    wishlist.push(id);
                    btn.classList.add('active');
                }
                localStorage.setItem('wishlist', JSON.stringify(wishlist));
            });
        });
        // Order CTA
        document.querySelectorAll('.add-to-cart').forEach(btn => {
            btn.addEventListener('click', function() {
                const card = btn.closest('.product-card');
                const title = card.querySelector('.product-title').innerText;
                alert(`Requested order for ${title}. Our team will contact you!`);
            });
        });
    </script>
