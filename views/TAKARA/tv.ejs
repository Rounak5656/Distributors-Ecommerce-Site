<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order TV - Kailash Electronics</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/theme-overrides.css">
    <script src="/javascripts/theme.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            margin: 0 auto;
            max-width: 1300px;
            width: 95%;
            min-height: 100vh;
            background: radial-gradient(circle at top left, rgba(255, 223, 0, 0.08), transparent 18%),
                        radial-gradient(circle at bottom right, rgba(255, 255, 255, 0.06), transparent 20%),
                        linear-gradient(180deg, #080708 0%, #141214 52%, #1d1b1f 100%);
            color: #f1f0ef;
            font-family: 'Poppins', sans-serif;
            line-height: 1.65;
            position: relative;
            display: flex;
            flex-direction: column;
            padding: 2rem 0 3rem;
        }
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at top center, rgba(255,255,255,0.06), transparent 20%),
                        linear-gradient(135deg, rgba(255,215,0,0.03), transparent 45%);
            pointer-events: none;
            z-index: 0;
        }
        .header {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            background: rgba(12, 12, 12, 0.84);
            border: 1px solid rgba(255, 215, 0, 0.18);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
            border-radius: 26px;
            padding: 1.8rem 2rem;
            margin: 0 1rem 2rem;
            backdrop-filter: blur(12px);
        }
        .header h1 {
            font-size: clamp(2rem, 3vw, 3.2rem);
            margin-bottom: 0.35rem;
            color: #f9f6f1;
            font-family: 'Playfair Display', serif;
            letter-spacing: 0.03em;
            text-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
        }
        .header p {
            margin-top: 0.3rem;
            font-size: 1rem;
            color: #d8c9b8;
            max-width: 620px;
        }
        .wishlist-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            background: rgba(255, 215, 0, 0.14);
            color: #f6e4c3;
            border: 1px solid rgba(255, 215, 0, 0.28);
            padding: 0.9rem 1.4rem;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 600;
            box-shadow: 0 16px 40px rgba(0,0,0,0.22);
            transition: transform 0.25s ease, background 0.25s ease;
            white-space: nowrap;
            z-index: 2;
        }
        .wishlist-link:hover {
            transform: translateY(-2px);
            background: rgba(255, 215, 0, 0.22);
        }
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            padding: 0 1rem;
            width: 100%;
            z-index: 1;
        }
        .product-card {
            background: rgba(15, 15, 15, 0.88);
            border-radius: 26px;
            overflow: hidden;
            box-shadow: 0 28px 70px rgba(0, 0, 0, 0.38);
            transition: transform 0.35s ease, box-shadow 0.35s, border-color 0.35s;
            position: relative;
            color: #f7f4ef;
            border: 1px solid rgba(255, 215, 0, 0.12);
            display: flex;
            flex-direction: column;
        }
        .product-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 34px 80px rgba(0, 0, 0, 0.45);
            border-color: rgba(255, 215, 0, 0.3);
        }
        .product-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent 40%);
            pointer-events: none;
        }
        .product-image {
            position: relative;
            width: 100%;
            min-height: 240px;
            background: radial-gradient(circle at top, rgba(255,255,255,0.08), transparent 35%),
                        linear-gradient(180deg, rgba(255, 215, 0, 0.06), transparent 70%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .product-image img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 20px 35px rgba(0,0,0,0.35));
        }
        .product-image::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(255,215,0,0.12), transparent 40%);
            opacity: 0.35;
            pointer-events: none;
        }
        .wishlist-btn {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(20, 20, 20, 0.82);
            border: 1px solid rgba(255, 215, 0, 0.24);
            color: #f8e7c8;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.25s ease;
            z-index: 1;
        }
        .wishlist-btn.active { color: #ffd966; }
        .wishlist-btn:hover {
            background: rgba(255, 215, 0, 0.14);
            color: #fff;
            transform: scale(1.05);
        }
        .product-info {
            padding: 1.8rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .product-title {
            font-size: 1.2rem;
            color: #ffe8b0;
            margin-bottom: 0.35rem;
            letter-spacing: 0.03em;
            font-weight: 700;
        }
        .product-description {
            color: #d6c9b8;
            margin: 0;
            font-size: 0.96rem;
            line-height: 1.65;
        }
        .product-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: rgba(255, 215, 0, 0.12);
            color: #ffebc7;
            padding: 0.45rem 0.9rem;
            border-radius: 999px;
            font-size: 0.8rem;
            letter-spacing: 0.04em;
            width: fit-content;
        }
        .product-meta {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 1rem;
            align-items: center;
        }
        .min-order {
            color: #f3d18b;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.55rem;
        }
        .quantity-controls {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
            background: rgba(255,255,255,0.04);
            padding: 0.65rem 0.75rem;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.08);
        }
        .quantity-btn {
            background: rgba(255, 215, 0, 0.14);
            color: #f7f4ef;
            border: 1px solid rgba(255, 215, 0, 0.22);
            border-radius: 50%;
            width: 36px;
            height: 36px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.2s ease;
        }
        .quantity-btn:hover {
            background: rgba(255, 215, 0, 0.28);
            transform: translateY(-1px);
        }
        .qty {
            min-width: 2rem;
            text-align: center;
            display: inline-block;
            color: #f3e8d6;
            font-weight: 600;
        }
        .add-to-cart {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.95), rgba(255, 182, 56, 0.92));
            color: #1a1511;
            border: none;
            padding: 0.95rem 1.2rem;
            border-radius: 999px;
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            width: 100%;
            margin-top: 0.5rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            box-shadow: 0 18px 40px rgba(255, 183, 63, 0.22);
        }
        .add-to-cart:hover {
            transform: translateY(-2px);
            box-shadow: 0 22px 48px rgba(255, 183, 63, 0.3);
        }
        .add-to-cart:disabled {
            background: #6b6b6b;
            color: #ece9e5;
            cursor: not-allowed;
            box-shadow: none;
        }
        @media (max-width: 1024px) {
            body { padding: 1.5rem 0 2.5rem; }
            .products-grid { gap: 1.6rem; }
        }
        @media (max-width: 768px) {
            .header { padding: 1.5rem 1.2rem; margin: 0 1rem 1.5rem; }
            .product-card { border-radius: 22px; }
            .product-image { min-height: 220px; }
            .product-info { padding: 1.4rem; }
        }
        @media (max-width: 600px) {
            .header { text-align: center; justify-content: center; }
            .wishlist-link { width: 100%; justify-content: center; }
            .product-card { min-width: 0; }
            .products-grid { grid-template-columns: 1fr; gap: 1.2rem; padding: 0 0.5rem; }
            .header h1 { font-size: 2rem; }
        }
    </style>
</head>
<body class="themeable-page">
    <div class="header">
        <div>
            <h1>TAKARA Luxe TV Collection</h1>
            <p>Discover premium smart TVs designed for elevated spaces, curated with refined finishes, cinematic clarity, and unmatched style.</p>
        </div>
        <a href="/wishlist" class="wishlist-link"><i class="fa fa-heart"></i> My Wishlist</a>
    </div>
    <div class="products-grid">
        <!-- Demo TV Products -->
        <div class="product-card" data-id="tv1">
            <div class="product-image">
                <img src="/images/takara-tv1.png" alt="TV 1">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">32" LED Smart TV</div>
                <div class="product-badge">Premium Edition</div>
                <div class="product-description">HD Ready, Smart Apps, 2 HDMI, 1 USB</div>
                <div class="product-meta">
                    <div class="min-order"><i class="fa fa-box"></i> Minimum Order: <span class="min">2</span> units</div>
                </div>
                <div class="quantity-controls">
                    <button class="quantity-btn" onclick="changeQty(this, -1)">-</button>
                    <span class="qty">2</span>
                    <button class="quantity-btn" onclick="changeQty(this, 1)">+</button>
                </div>
                <button class="add-to-cart">Order Now</button>
            </div>
        </div>
        <div class="product-card" data-id="tv2">
            <div class="product-image">
                <img src="/images/takara-tv2.png" alt="TV 2">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">43" 4K Ultra HD TV</div>
                <div class="product-badge">Cinematic Series</div>
                <div class="product-description">Ultra HD, Voice Remote, 3 HDMI, 2 USB</div>
                <div class="product-meta">
                    <div class="min-order"><i class="fa fa-box"></i> Minimum Order: <span class="min">1</span> unit</div>
                </div>
                <div class="quantity-controls">
                    <button class="quantity-btn" onclick="changeQty(this, -1)">-</button>
                    <span class="qty">1</span>
                    <button class="quantity-btn" onclick="changeQty(this, 1)">+</button>
                </div>
                <button class="add-to-cart">Order Now</button>
            </div>
        </div>
        <!-- Add more products as needed -->
    </div>
    <script>
        // Quantity Control
        function changeQty(btn, delta) {
            const qtySpan = btn.parentElement.querySelector('.qty');
            const min = parseInt(btn.parentElement.parentElement.querySelector('.min').innerText);
            let qty = parseInt(qtySpan.innerText);
            qty += delta;
            if(qty < min) qty = min;
            qtySpan.innerText = qty;
        }
        // Wishlist Feature (shared localStorage)
        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            const card = btn.closest('.product-card');
            const id = card.getAttribute('data-id');
            if(JSON.parse(localStorage.getItem('wishlist')||'[]').includes(id)) {
                btn.classList.add('active');
            }
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                let wishlist = JSON.parse(localStorage.getItem('wishlist')||'[]');
                if(wishlist.includes(id)) {
                    wishlist = wishlist.filter(x=>x!==id);
                    btn.classList.remove('active');
                } else {
                    wishlist.push(id);
                    btn.classList.add('active');
                }
                localStorage.setItem('wishlist', JSON.stringify(wishlist));
            });
        });
        // Add to cart/Order
        document.querySelectorAll('.add-to-cart').forEach(btn => {
            btn.addEventListener('click', function() {
                const card = btn.closest('.product-card');
                const title = card.querySelector('.product-title').innerText;
                const qty = card.querySelector('.qty').innerText;
                alert(`Ordered ${qty} unit(s) of ${title}!`);
            });
        });
    </script>
</body>
</html>
