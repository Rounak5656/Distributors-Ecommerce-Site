<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zebronics TVs - KAMLAS</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            margin: 0 auto;
            max-width: 1200px;
            width: 95%;
            background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
            color: #fff;
            font-family: 'Poppins', sans-serif;
            line-height: 1.6;
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .header { text-align: center; margin: 2em 0; animation: fadeIn 1s ease-in; flex: 0 0 auto; position: relative; }
        .header h1 { font-size: 2.2em; margin-bottom: 0.2em; color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .header p { color: #b2f7ef; font-size: 0.95em; }
        .breadcrumbs { text-align: center; margin-top: .5em; color: #9adbd7; font-size: .85em; }
        .wishlist-link { position: absolute; top: 2em; right: 2em; background: #4ecdc4; color: #1a1a1a; padding: 0.5em 1.2em; border-radius: 20px; text-decoration: none; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,0.08); transition: background 0.3s; }
        .wishlist-link:hover { background: #38b2ac; }

        .section-title { margin: 1.2em 0 .3em; padding-left: .4em; border-left: 4px solid #4ecdc4; color: #4ecdc4; font-size: 1.2em; letter-spacing: .5px; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.4em; padding: 1.4em; max-width: 1200px; margin: 0 auto; }
        .product-card { background: linear-gradient(145deg, #2a2a2a, #1a1a1a); border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.2); transition: transform 0.3s ease, box-shadow 0.3s; position: relative; color: #fff; display: flex; flex-direction: column; align-items: stretch; }
        .product-card:hover { transform: translateY(-8px); box-shadow: 0 16px 32px rgba(78,205,196,0.15); }
        .badge { position: absolute; top: 12px; left: 12px; background: #4ecdc4; color: #1a1a1a; font-weight: 700; padding: .25em .6em; border-radius: 6px; font-size: .75em; }
        .product-image { width: 100%; height: 200px; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; }
        .product-image img { max-width: 100%; max-height: 100%; object-fit: contain; }
        .wishlist-btn { position: absolute; top: 10px; right: 10px; background: rgba(30,30,30,0.9); border: none; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease; color: #4ecdc4; font-size: 1.1em; }
        .wishlist-btn.active { color: #e74c3c; }
        .wishlist-btn:hover { background: #232323; color: #e74c3c; }
        .product-info { padding: 1.1em; display: flex; flex-direction: column; gap: .5em; }
        .product-title { font-size: 1.05em; color: #4ecdc4; margin: 0; text-shadow: 0 0 6px rgba(78,205,196,0.15); }
        .product-description { color: #d7f9f6; margin: 0; font-size: 0.9em; min-height: 40px; }
        .spec-list { list-style: none; margin: .2em 0 0; padding: 0; color: #bcefee; font-size: .85em; display: grid; grid-template-columns: 1fr 1fr; gap: .3em .8em; }
        .spec-list li i { color: #4ecdc4; margin-right: .4em; }
        .cta-row { display: flex; align-items: center; gap: .6em; margin-top: .5em; }
        .price { color: #fff; font-weight: 700; letter-spacing: .5px; }
        .add-to-cart { background: #4ecdc4; color: #1a1a1a; border: none; padding: 0.6em 1em; border-radius: 10px; cursor: pointer; transition: background 0.3s, color 0.3s; font-weight: 700; }
        .add-to-cart:hover { background: #38b2ac; color: #fff; }
        .min-order { color: #ffb3b3; font-size: 0.85em; }
        @media (max-width: 900px) { .products-grid { grid-template-columns: 1fr !important; gap: 1em !important; padding: 1em !important; } .header { margin: 1em 0 !important; } }
        @media (max-width: 600px) { .header h1 { font-size: 1.3em !important; } .product-card { min-width: 0 !important; max-width: 100% !important; } .products-grid { gap: 0.8em !important; padding: 0.8em !important; } }
        @media (max-width: 400px) { .header h1 { font-size: 1em !important; } .product-card { padding: 0 !important; } }
    </style>
</head>
<body>
    <div class="header">
        <h1>Zebronics Televisions</h1>
        <p>Explore HD Ready to 4K UHD TVs with smart features, vivid panels, and immersive sound.</p>
        <div class="breadcrumbs">Home / Zebronics / Televisions</div>
        <a href="/wishlist" class="wishlist-link"><i class="fa fa-heart"></i> My Wishlist</a>
    </div>

    <h2 class="section-title">Featured</h2>
    <div class="products-grid">
        <div class="product-card" data-id="zeb-tv-43-uhd">
            <span class="badge">Best Seller</span>
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?q=80&w=1200&auto=format&fit=crop" alt="43 inch 4K UHD TV">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">43" 4K Ultra HD Smart TV</div>
                <p class="product-description">Bezel‑less design, 4K HDR, Dolby Audio, Dual-band Wi‑Fi</p>
                <ul class="spec-list">
                    <li><i class="fa fa-tv"></i> 3840×2160, HDR10</li>
                    <li><i class="fa fa-microchip"></i> Quad‑core, 2GB/16GB</li>
                    <li><i class="fa fa-wifi"></i> Wi‑Fi 2.4/5GHz</li>
                    <li><i class="fa fa-plug"></i> 3×HDMI, 2×USB</li>
                </ul>
                <div class="cta-row">
                    <span class="price">₹29,990</span>
                    <span class="min-order"><i class="fa fa-box"></i> MOQ: 2 units</span>
                    <button class="add-to-cart">Order</button>
                </div>
            </div>
        </div>
        <div class="product-card" data-id="zeb-tv-55-uhd">
            <span class="badge">4K UHD</span>
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1593359677879-9749f0098f2b?q=80&w=1200&auto=format&fit=crop" alt="55 inch 4K UHD TV">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">55" 4K Ultra HD Smart TV</div>
                <p class="product-description">Wide color gamut, MEMC, Voice Remote, Chromecast built‑in</p>
                <ul class="spec-list">
                    <li><i class="fa fa-tv"></i> 60Hz Panel</li>
                    <li><i class="fa fa-volume-up"></i> 30W Speakers</li>
                    <li><i class="fa fa-microphone"></i> Voice Assistant</li>
                    <li><i class="fa fa-plug"></i> 3×HDMI, eARC</li>
                </ul>
                <div class="cta-row">
                    <span class="price">₹42,990</span>
                    <span class="min-order"><i class="fa fa-box"></i> MOQ: 1 unit</span>
                    <button class="add-to-cart">Order</button>
                </div>
            </div>
        </div>
    </div>

    <h2 class="section-title">Budget</h2>
    <div class="products-grid">
        <div class="product-card" data-id="zeb-tv-32-hd">
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1583224931233-4d635cdba79e?q=80&w=1200&auto=format&fit=crop" alt="32 inch Smart TV">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">32" HD Ready Smart TV</div>
                <p class="product-description">HD Ready panel, Quad‑core, YouTube/Prime/Netflix</p>
                <ul class="spec-list">
                    <li><i class="fa fa-tv"></i> 1366×768</li>
                    <li><i class="fa fa-plug"></i> 2×HDMI, 2×USB</li>
                    <li><i class="fa fa-wifi"></i> 2.4GHz Wi‑Fi</li>
                    <li><i class="fa fa-microchip"></i> 1GB/8GB</li>
                </ul>
                <div class="cta-row">
                    <span class="price">₹11,990</span>
                    <span class="min-order"><i class="fa fa-box"></i> MOQ: 3 units</span>
                    <button class="add-to-cart">Order</button>
                </div>
            </div>
        </div>
        <div class="product-card" data-id="zeb-tv-40-fhd">
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1599507593238-5bea0743a653?q=80&w=1200&auto=format&fit=crop" alt="40 inch Full HD TV">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">40" Full HD Smart TV</div>
                <p class="product-description">FHD panel, DTS sound, Dual HDMI</p>
                <ul class="spec-list">
                    <li><i class="fa fa-tv"></i> 1920×1080</li>
                    <li><i class="fa fa-volume-up"></i> 24W Speakers</li>
                    <li><i class="fa fa-wifi"></i> Wi‑Fi, Miracast</li>
                    <li><i class="fa fa-plug"></i> HDMI ×2</li>
                </ul>
                <div class="cta-row">
                    <span class="price">₹16,990</span>
                    <span class="min-order"><i class="fa fa-box"></i> MOQ: 2 units</span>
                    <button class="add-to-cart">Order</button>
                </div>
            </div>
        </div>
    </div>

    <h2 class="section-title">Premium</h2>
    <div class="products-grid">
        <div class="product-card" data-id="zeb-tv-65-uhd">
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1585079542156-2755d9c8affd?q=80&w=1200&auto=format&fit=crop" alt="65 inch 4K TV">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">65" 4K UHD Smart TV</div>
                <p class="product-description">Dolby Vision/Atmos, MEMC, Premium metal design</p>
                <ul class="spec-list">
                    <li><i class="fa fa-tv"></i> 4K HDR10+/HLG</li>
                    <li><i class="fa fa-microphone"></i> Voice Assistant</li>
                    <li><i class="fa fa-wifi"></i> Dual‑band Wi‑Fi</li>
                    <li><i class="fa fa-plug"></i> HDMI 2.1</li>
                </ul>
                <div class="cta-row">
                    <span class="price">₹62,990</span>
                    <span class="min-order"><i class="fa fa-box"></i> MOQ: 1 unit</span>
                    <button class="add-to-cart">Order</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Wishlist Feature (shared localStorage)
        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            const card = btn.closest('.product-card');
            const id = card.getAttribute('data-id');
            if(JSON.parse(localStorage.getItem('wishlist')||'[]').includes(id)) {
                btn.classList.add('active');
            }
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                let wishlist = JSON.parse(localStorage.getItem('wishlist')||'[]');
                if(wishlist.includes(id)) {
                    wishlist = wishlist.filter(x=>x!==id);
                    btn.classList.remove('active');
                } else {
                    wishlist.push(id);
                    btn.classList.add('active');
                }
                localStorage.setItem('wishlist', JSON.stringify(wishlist));
            });
        });
        // Order CTA
        document.querySelectorAll('.add-to-cart').forEach(btn => {
            btn.addEventListener('click', function() {
                const card = btn.closest('.product-card');
                const title = card.querySelector('.product-title').innerText;
                alert(`Requested order for ${title}. Our team will contact you!`);
            });
        });
    </script>
</body>
</html>
