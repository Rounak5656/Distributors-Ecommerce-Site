<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zebronics Air Conditioners - Kailash Electronics</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/theme-overrides.css">
    <script src="/javascripts/theme.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        nav { background: rgba(26, 26, 26, 0.95); padding: 1em 2em; display: flex; justify-content: flex-end; align-items: center; box-shadow: 0 2px 8px rgba(0,0,0,0.3); position: sticky; top: 0; z-index: 100; }
        nav a { background: #4ecdc4; color: #1a1a1a; padding: 0.6em 1.4em; border-radius: 20px; text-decoration: none; font-weight: 600; transition: background 0.3s; display: flex; align-items: center; gap: 0.5em; }
        nav a:hover { background: #38b2ac; }
        body { margin: 0 auto; max-width: 1200px; width: 95%; background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%); color: #fff; font-family: 'Poppins', sans-serif; line-height: 1.6; position: relative; min-height: 100vh; display: flex; flex-direction: column; }
        .header { text-align: center; margin: 2em 0; animation: fadeIn 1s ease-in; flex: 0 0 auto; position: relative; }
        .header h1 { font-size: 2.2em; margin-bottom: 0.2em; color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }
        .header p { color: #b2f7ef; font-size: 0.95em; }
        .breadcrumbs { text-align: center; margin-top: .5em; color: #9adbd7; font-size: .85em; }
        .section-title { margin: 1.2em 0 .3em; padding-left: .4em; border-left: 4px solid #4ecdc4; color: #4ecdc4; font-size: 1.2em; letter-spacing: .5px; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.4em; padding: 1.4em; max-width: 1200px; margin: 0 auto; }
        .product-card { background: linear-gradient(145deg, #2a2a2a, #1a1a1a); border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.2); transition: transform 0.3s ease, box-shadow 0.3s; position: relative; color: #fff; display: flex; flex-direction: column; align-items: stretch; }
        .product-card:hover { transform: translateY(-8px); box-shadow: 0 16px 32px rgba(78,205,196,0.15); }
        .badge { position: absolute; top: 12px; left: 12px; background: #4ecdc4; color: #1a1a1a; font-weight: 700; padding: .25em .6em; border-radius: 6px; font-size: .75em; z-index: 10; }
        .product-image { width: 100%; aspect-ratio: 16 / 9; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
        .product-image img { max-width: 100%; max-height: 100%; object-fit: contain; }
        .product-image img.image-error { display: none; }
        .slider-image.image-missing::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%); opacity: 0.7; }
        .slider-image.image-missing::after { content: '⚠'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 3em; color: #4ecdc4; opacity: 0.9; z-index: 1; }
        .no-image-text { position: absolute; bottom: 15%; left: 50%; transform: translateX(-50%); color: #bcefee; font-size: 0.85em; text-align: center; z-index: 2; width: 90%; }
        .wishlist-btn { position: absolute; top: 10px; right: 10px; background: rgba(30,30,30,0.9); border: none; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease; color: #4ecdc4; font-size: 1.1em; z-index: 10; }
        .wishlist-btn.active { color: #e74c3c; }
        .wishlist-btn:hover { background: #232323; color: #e74c3c; }
        .product-info { padding: 1.4em; display: flex; flex-direction: column; gap: 0.8em; }
        .product-title { font-size: 1.2em; font-weight: 600; color: #4ecdc4; margin: 0; text-shadow: 0 0 6px rgba(78,205,196,0.15); }
        .product-description { color: #d7f9f6; margin: 0; font-size: 0.9em; min-height: 40px; }
        .spec-list { list-style: none; margin: .2em 0 0; padding: 0; color: #bcefee; font-size: .85em; display: grid; grid-template-columns: 1fr 1fr; gap: .5em .8em; }
        .spec-list li { display: flex; align-items: center; padding: 0.3em 0; }
        .spec-list li i { color: #a0a0a0; margin-right: .4em; min-width: 1em; text-align: center; }
        .cta-row { display: flex; align-items: center; gap: .6em; margin-top: .8em; flex-wrap: wrap; }
        .price { color: #fff; font-weight: 700; letter-spacing: .5px; }
        .add-to-cart { background: #ff6b35; color: #fff; border: none; padding: 0.7em 1.2em; border-radius: 10px; cursor: pointer; transition: background 0.3s, transform 0.2s; font-weight: 700; flex: 1; min-width: 100px; text-align: center; }
        .add-to-cart:hover { background: #ff5722; transform: scale(1.05); }
        .min-order { color: #8a7a7a; font-size: 0.75em; opacity: 0.8; }
        @media (max-width: 900px) { .products-grid { grid-template-columns: 1fr !important; gap: 1em !important; padding: 1em !important; } .header { margin: 1em 0 !important; } }
        @media (max-width: 600px) { .header h1 { font-size: 1.3em !important; } .product-card { min-width: 0 !important; max-width: 100% !important; } .products-grid { gap: 0.8em !important; padding: 0.8em !important; } }
        @media (max-width: 400px) { .header h1 { font-size: 1em !important; } .product-card { padding: 0 !important; } }
    </style>
</head>
<body class="themeable-page">
    <nav>
        <a href="/wishlist"><i class="fa fa-heart"></i> My Wishlist</a>
    </nav>
    <div class="header">
        <h1>Zebronics Air Conditioners</h1>
        <p>Energy efficient Split & Window ACs with inverter tech and fast cooling.</p>
        <div class="breadcrumbs">Home / Zebronics / Air Conditioners</div>
    </div>

    <h2 class="section-title">Split AC</h2>
    <div class="products-grid">
        <div class="product-card" data-id="zeb-ac-split-15">
            <span class="badge">Inverter</span>
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1587049352847-4a222e784d38?q=80&w=1200&auto=format&fit=crop" alt="1.5 Ton Split AC">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">1.5 Ton 5 Star Split AC</div>
                <p class="product-description">Copper condenser, Anti‑bacterial filter, Eco mode</p>
                <ul class="spec-list">
                    <li><i class="fa fa-snowflake"></i> Inverter Compressor</li>
                    <li><i class="fa fa-leaf"></i> 5 Star BEE</li>
                    <li><i class="fa fa-fan"></i> Turbo Cool</li>
                    <li><i class="fa fa-shield"></i> Stabilizer Free</li>
                </ul>
                <div class="cta-row">
                    <span class="price">₹34,990</span>
                    <span class="min-order"><i class="fa fa-box"></i> MOQ: 2 units</span>
                    <button class="add-to-cart">Order</button>
                </div>
            </div>
        </div>
        <div class="product-card" data-id="zeb-ac-split-10">
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1603808032803-9f91ecdeef7d?q=80&w=1200&auto=format&fit=crop" alt="1 Ton Split AC">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">1 Ton 3 Star Split AC</div>
                <p class="product-description">Fast cooling, Sleep mode, Low noise</p>
                <ul class="spec-list">
                    <li><i class="fa fa-leaf"></i> Eco Mode</li>
                    <li><i class="fa fa-volume-down"></i> 28 dB</li>
                    <li><i class="fa fa-fan"></i> 4‑way Swing</li>
                    <li><i class="fa fa-shield-alt"></i> R32 Refrigerant</li>
                </ul>
                <div class="cta-row">
                    <span class="price">₹27,990</span>
                    <span class="min-order"><i class="fa fa-box"></i> MOQ: 2 units</span>
                    <button class="add-to-cart">Order</button>
                </div>
            </div>
        </div>
    </div>

    <h2 class="section-title">Window AC</h2>
    <div class="products-grid">
        <div class="product-card" data-id="zeb-ac-window-10">
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1600585154526-990dced4db0d?q=80&w=1200&auto=format&fit=crop" alt="Window AC">
                <button class="wishlist-btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
            </div>
            <div class="product-info">
                <div class="product-title">1 Ton Window AC</div>
                <p class="product-description">Anti‑dust filter, Sleep mode, Auto restart</p>
                <ul class="spec-list">
                    <li><i class="fa fa-leaf"></i> 3 Star BEE</li>
                    <li><i class="fa fa-fan"></i> Turbo mode</li>
                    <li><i class="fa fa-tools"></i> Easy install</li>
                    <li><i class="fa fa-shield-alt"></i> Blue Fin</li>
                </ul>
                <div class="cta-row">
                    <span class="price">₹21,990</span>
                    <span class="min-order"><i class="fa fa-box"></i> MOQ: 1 unit</span>
                    <button class="add-to-cart">Order</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Handle missing images
        document.querySelectorAll('.product-image img').forEach(img => {
            img.addEventListener('error', function() {
                this.classList.add('image-error');
                const productImage = this.closest('.product-image');
                const sliderImage = productImage.querySelector('.slider-image') || productImage;
                sliderImage.classList.add('image-missing');
                
                // Add no image text if not already present
                if (!sliderImage.querySelector('.no-image-text')) {
                    const textDiv = document.createElement('div');
                    textDiv.className = 'no-image-text';
                    textDiv.textContent = 'Image Not Available';
                    sliderImage.appendChild(textDiv);
                }
            });
        });

        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            const card = btn.closest('.product-card');
            const id = card.getAttribute('data-id');
            if(JSON.parse(localStorage.getItem('wishlist')||'[]').includes(id)) btn.classList.add('active');
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                let wishlist = JSON.parse(localStorage.getItem('wishlist')||'[]');
                if(wishlist.includes(id)) { wishlist = wishlist.filter(x=>x!==id); btn.classList.remove('active'); }
                else { wishlist.push(id); btn.classList.add('active'); }
                localStorage.setItem('wishlist', JSON.stringify(wishlist));
            });
        });
        document.querySelectorAll('.add-to-cart').forEach(btn => {
            btn.addEventListener('click', function() {
                const card = btn.closest('.product-card');
                const title = card.querySelector('.product-title').innerText;
                alert(`Requested order for ${title}. Our team will contact you!`);
            });
        });
    </script>
</body>
</html>
